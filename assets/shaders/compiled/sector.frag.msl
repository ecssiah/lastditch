#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
    uint input_block_type [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d_array<float> block_texture [[texture(0)]], sampler block_sampler [[sampler(0)]])
{
    main0_out out = {};
    float3 _75 = float3(in.input_uv, float(in.input_block_type));
    out._entryPointOutput = block_texture.sample(block_sampler, _75.xy, uint(rint(_75.z)));
    return out;
}

