#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> font_texture [[texture(0)]], sampler font_sampler [[sampler(0)]])
{
    main0_out out = {};
    out._entryPointOutput = font_texture.sample(font_sampler, in.input_uv);
    return out;
}

